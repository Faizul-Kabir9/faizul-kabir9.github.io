/*-- scss:defaults --*/
$primary: #24504a;
$font-family-sans-serif: "Georgia", "Times New Roman", serif;
$grid-body-width: 1050px;   // wider page overall

/*-- scss:rules --*/
h1, h2 { font-weight: 700; }
.navbar { letter-spacing: 0.02em; }

/* Trestles layout: shrink the left (photo) column, widen the text side */
div.quarto-about-trestles {
  grid-template-columns: minmax(0, 3fr) minmax(0, 7fr) !important;
  gap: 2.5em;
}

/* Keep the photo block pinned toward the top-left, not floating mid-page */
div.quarto-about-trestles .about-entity {
  align-self: start;
  padding-top: 1em;
}

/* Slightly smaller, cleaner buttons under the photo */
.about-links .about-link {
  font-size: 0.9em;
}